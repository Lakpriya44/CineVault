# Copy this file to ".env" and adjust the values.
NODE_ENV=development
PORT=5000

# Local MongoDB. When Docker Compose is added later, the host becomes the service name (e.g. mongodb://mongo:27017/cinevault).
MONGODB_URI=mongodb://127.0.0.1:27017/cinevault

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app runs (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Set to true only when the site is served over HTTPS. Keep false for plain-HTTP lab machines.
COOKIE_SECURE=false
